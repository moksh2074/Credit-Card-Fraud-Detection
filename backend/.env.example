# Database configuration
# PostgreSQL URL (recommended with pgAdmin local server)
# Accepts:
# - postgresql://user:password@localhost:5432/transactions_db
# - postgresql+asyncpg://user:password@localhost:5432/transactions_db
# App auto-normalizes to asyncpg when needed.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transactions_db

# Security
SECRET_KEY=replace-this-with-a-secure-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15

# IBM Cloud Object Storage
IBM_COS_API_KEY=your_ibm_cos_api_key
IBM_COS_INSTANCE_CRN=your_ibm_cos_instance_crn
IBM_COS_BUCKET=your_ibm_cos_bucket

# IBM Cloud Event Notifications
IBM_NOTIFICATIONS_GUID=your_ibm_notifications_guid

# IBM Cloud App ID authentication
# Use App ID service credentials from your App ID application.
IBM_APPID_CLIENT_ID=your_appid_client_id
IBM_APPID_CLIENT_SECRET=your_appid_client_secret
IBM_APPID_TENANT_ID=your_appid_tenant_id
IBM_APPID_OAUTH_SERVER_URL=https://<region>.appid.cloud.ibm.com/oauth/v4/<tenant_id>
IBM_APPID_DISCOVERY_URL=https://<region>.appid.cloud.ibm.com/oauth/v4/<tenant_id>/.well-known/openid-configuration
IBM_APPID_REDIRECT_URI=http://localhost:8000/api/v1/auth/appid/callback
IBM_APPID_DEFAULT_ROLE=analyst
IBM_APPID_DEFAULT_ORG_ID=org_001
# Required only for registering users into Cloud Directory from this app.
IBM_APPID_IAM_API_KEY=your_ibm_cloud_iam_api_key
FRONTEND_URL=http://localhost:3000

# Redis Core (used by Celery and caching)
REDIS_URL=redis://localhost:6379/0

# Wazuh SIEM Integration
WAZUH_MANAGER_URL=https://localhost:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=wazuh

# Optional AWS S3 archival for flagged fraud logs.
# Keep disabled for local-only mode (pipeline remains fully functional).
AWS_S3_ENABLED=false
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_PREFIX=fraud-logs/
AWS_S3_OBJECT_EXTENSION=.txt
AWS_S3_SINGLE_FILE_KEY=fraud logs.txt
# Optional custom endpoint for S3-compatible services (leave empty for AWS).
AWS_S3_ENDPOINT_URL=
# Set true to bypass system HTTP/HTTPS proxy while connecting to S3.
AWS_S3_DISABLE_PROXY=false
# Optional durable local queue file path for retrying uploads after S3 outages/deletes.
AWS_S3_PENDING_PATH=
# Optional local counter file path for deterministic, ordered S3 object sequencing.
AWS_S3_SEQUENCE_PATH=
AWS_S3_FLUSH_EVERY_N_RECORDS=25
AWS_S3_RECORDS_PER_OBJECT=200
AWS_S3_MAX_OBJECTS_PER_FLUSH=3
AWS_S3_FLUSH_MIN_INTERVAL_SEC=5
